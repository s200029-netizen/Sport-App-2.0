<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Sport App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"
        defer></script>
        <link rel="stylesheet" href="reg.css" >
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" >
    </head>


<body>
    <div class="container">
        <div id="userCard" class="row text-white p-1 m-3 d-flex align-items-center" style="background-color: #8A2BE2;">
            <div id="userImage" class="col fs-5">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/59/Carriage_Lau_in_2023.jpg" class="img-fluid" style="width:120px; height: auto;" alt="劉馬車">
            </div>
            <div id="userInfo" class="col">
                <div class="fw-bold">Name: 劉馬車</div>
                <div>Age: 30</div>
                <div>Class:5HO</div>
                <div>Gender:M</div>
                <div>House:Blue</div>
            </div>

        </div>
        <div class="row">
            <h5>Running Events 徑項</h5>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="100m" id="100m" value="100m">
                <label class="btn btn-outline-primary w-100 " for="100m">100m</label>
            </div>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="200m" id="200m" value="200m">
                <label class="btn btn-outline-primary w-100 " for="200m">200m</label>
            </div>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="400m" id="400m" value="400m">
                <label class="btn btn-outline-primary w-100 " for="400m">400m</label>
            </div>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="800m" id="800m" value="800m">
                <label class="btn btn-outline-primary w-100 " for="800m">800m</label>
            </div>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="1500m" id="1500m" value="1500m">
                <label class="btn btn-outline-primary w-100 " for="1500m">1500m</label>
            </div>
            <div class="col-5 w100 m-1">
                <input type="checkbox" class="btn-check" name="5000m" id="5000m" value="5000m">
                <label class="btn btn-outline-primary w-100 " for="5000m">5000m</label>
            </div>

            <h5>Field Events 田項</h5>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="high jump" id="high jump" value="high jump">
                <label class="btn btn-outline-primary w-100 " for="high jump">
                    <div>跳高</div>
                    <div>high jump</div>
                </label>

            </div>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="Discuss Throw" id="Discuss Throw" value="Discuss Throw">
                <label class="btn btn-outline-primary w-100 " for="Discuss Throw">
                    <div>鐵餅</div>
                    <div>Discuss Throw </div>
                </label>
            </div>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="long jump" id="long jump" value="long jump">
                <label class="btn btn-outline-primary w-100 " for="long jump">
                    <div>跳遠</div>
                    <div>long jump </div>
                </label>
            </div>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="shot put" id="shot put" value="shot put">
                <label class="btn btn-outline-primary w-100 " for="shot put">
                    <div>推鉛球</div>
                    <div>shot put </div>
                </label>
            </div>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="Triple Jump" id="Triple Jump" value="Triple Jump">
                <label class="btn btn-outline-primary w-100 " for="Triple Jump">
                    <div>三級跳</div>
                    <div>Triple Jump</div>
                </label>
            </div>
            <h6>接力</h6>
            <div class="col-5 m-1">
                <input type="checkbox" class="btn-check" name="4 X 100M" id="4 X 100M" value="4 X 100M">
                <label class="btn btn-outline-primary w-100 " for="4 X 100M">
                    <div>4 X 100M 接力</div>
                </label>
            </div>
                <div class="col-5 m-1">
                    <input type="checkbox" class="btn-check" name="4 X 400M" id="4 X 400M" value="4 X 400M">
                    <label class="btn btn-outline-primary w-100 " for="4 X 400M">
                        <div>4 X 400M 接力</div>
                    </label>
                </div>

                <nav class="fixed-bottom border-top d-flex justify-content-around p-2">
                    <a href="http://127.0.0.1:5500/reg.html" class="text-decoration-none flex-fill text-black text-center"><i
                            class="bi bi-person-fill"></i>Registration 報名</a>
                    <a href="http://127.0.0.1:5500/Score.html" class="text-decoration-none flex-fill text-black text-center"><i 
                        class="bi bi-book"></i></i>Score 成績</a>
                    <a href="#" class="text-decoration-none flex-fill text-black text-center"><i
                            class="bi bi-card-checklist"></i></i>Roll Call 點名</a>
                    <a href="#" class="text-decoration-none flex-fill text-black text-center"><i
                         class="bi bi-clock"></i></i>Schedule時間表</a>
                    <a href="#" class="text-decoration-none flex-fill text-black text-center"><i
                            class="bi bi-clipboard-data"></i></i>Statistics 統計</a>
                    <a href="#" class="text-decoration-none flex-fill text-black text-center"><i class="bi bi-award"></i></i>Rank 排名</a>
                    <a href="http://127.0.0.1:5100/login_page.html" class="text-decoration-none flex-fill text-black text-center"><i
                            class="bi bi-door-open-fill"></i></i>Log out 登出</a>


                </nav>
</body>
